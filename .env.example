IMAGE_TAG=latest
APP_BIND=127.0.0.1
APP_PORT=8086
WORKSPACE_HOST_PATH=./workspace
CLI_AUTH_HOST_PATH=./cli-auth
DATA_HOST_PATH=./data
CLOUD_NETWORK_NAME=befw-cloud-network

AYAAN_QUERY_BASE_URL=http://gateway-cloud-gateway-1:10001/tsh/api/v1/internal/ayaan
AYAAN_QUERY_SERVICE_TOKEN=replace-with-same-value-as-query-service-token
AYAAN_ECC_BASE_URL=http://gateway-cloud-gateway-1:10001/ecc
AYAAN_ECC_TOKEN=replace-with-ecc-api-token
AYAAN_API_TOKEN=replace-with-long-random-secret
# d94-query's base64 JWT_SECRET_KEY (the same value as in d94-query .env), not the gateway secret
AYAAN_JWT_SECRET_KEY=replace-with-d94-query-JWT_SECRET_KEY
# JWT `sub` (d94 login email) allowed to call the API; comma list. Empty rejects every JWT
# (d94 registration is open). The X-AYAAN-Token service token is unaffected.
AYAAN_JWT_ALLOWED_SUBJECTS=
AYAAN_WORKSPACE_ROOTS=/workspace
# claude=/usr/local/bin/claude,codex=/usr/local/bin/codex,gemini=/usr/local/bin/gemini,cursor=/usr/local/bin/agent
AYAAN_CLI_EXECUTABLES=
AYAAN_DATA_DIR=/data
AYAAN_PROFILE=
# FAKE pause/resume acceptance (README "FAKE로 중단·재개 시험하기"):
# AYAAN_PROFILE=test
# AYAAN_FAKE_SCENARIO_FILE=/data/fake-scenario

# docker-compose.yml sets EUREKA_ENABLED/URL/INSTANCE_HOST/PORT for the container
AYAAN_EUREKA_ENABLED=false
AYAAN_EUREKA_URL=http://eureka-cloud-eureka-1:8761/eureka/
AYAAN_EUREKA_INSTANCE_HOST=d94-app-ayaan
